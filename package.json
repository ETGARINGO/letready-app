{
  "name": "letready",
  "version": "2.0.0",
  "private": true,
  "description": "LETReady — offline-first LET (Licensure Examination for Teachers) preparation app. PWA + Capacitor (Android/iOS).",
  "main": "www/index.html",
  "scripts": {
    "start": "npx serve www -l 5173",
    "dev": "npx serve www -l 5173",
    "cap:init": "npx cap init LETReady ph.letready.app --web-dir=www",
    "cap:add:android": "npx cap add android",
    "cap:add:ios": "npx cap add ios",
    "cap:sync": "npx cap sync",
    "cap:open:android": "npx cap open android",
    "cap:open:ios": "npx cap open ios",
    "build:apk": "npx cap sync android && cd android && ./gradlew assembleDebug"
  },
  "devDependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/cli": "^6.1.2",
    "@capacitor/core": "^6.1.2",
    "@capacitor/ios": "^6.1.2",
    "@capacitor/haptics": "^6.0.1",
    "@capacitor/splash-screen": "^6.0.2",
    "@capacitor/status-bar": "^6.0.1",
    "@capacitor/preferences": "^6.0.2",
    "serve": "^14.2.3"
  },
  "keywords": ["LET", "reviewer", "PWA", "education", "Philippines"],
  "license": "MIT"
}
